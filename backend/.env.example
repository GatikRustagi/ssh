# ──────────────────────────────────────────────────
# .env — fill in your real credentials before running
# Copy this file to .env and never commit it to git!
# ──────────────────────────────────────────────────

# Supabase
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key_here

# Twitter / X  (Bearer Token is enough for read-only v2 search)
TWITTER_BEARER_TOKEN=your_twitter_bearer_token_here

# Telegram  (get these from https://my.telegram.org)
TELEGRAM_API_ID=your_api_id_here
TELEGRAM_API_HASH=your_api_hash_here
TELEGRAM_PHONE=+91XXXXXXXXXX          # your phone number for Telegram auth
# Comma-separated list of public Telegram channel usernames to monitor
TELEGRAM_CHANNELS=indiatechcommunity,AIDiscussionIndia,startupindia

# Twitter search query (what keywords/hashtags to track)
TWITTER_QUERY=#IndiaAI OR #SIH2026 OR #AIStartup OR #DigitalIndia -is:retweet lang:en

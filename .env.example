# ── Twitter Credentials (agent-twitter-client) ────────────────────────────────
# Use a dedicated/throwaway Twitter account to avoid rate-limit issues
TWITTER_USERNAME=your_twitter_username
TWITTER_PASSWORD=your_twitter_password
TWITTER_EMAIL=your_twitter_email@example.com

# ── Supabase ──────────────────────────────────────────────────────────────────
# 1. Go to app.supabase.com → your project → Project Settings → API
# 2. Copy "Project URL" into SUPABASE_URL (no trailing slash or semicolon)
# 3. Copy "service_role" key (or "anon" for read-only) into SUPABASE_KEY
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your_full_key_here

# ── Scraper Config ────────────────────────────────────────────────────────────
SCRAPE_HASHTAG=#SIH2026
SCRAPE_MAX_ITEMS=50

# ── Optional: twitterapi.io (for real-time trend feed) ───────────────────────
# Sign up at https://twitterapi.io for a free API key
TWITTER_TRENDS_ENDPOINT=https://api.twitterapi.io/v1/trends
TWITTER_TRENDS_KEY=your-twitterapi-io-key
